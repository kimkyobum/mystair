{
  "entities": {
    "users": {
      "title": "User Profile",
      "description": "User profile data for each member",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "highSchool": { "type": "string" },
        "major": { "type": "string" },
        "mbti": { "type": "string" },
        "hollandCode": { "type": "string" },
        "targetCompanies": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid"]
    },
    "diaries": {
      "title": "Growth Diary Entries",
      "description": "User growth diary and reflection records",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "date": { "type": "string" },
        "mood": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string" }
      },
      "required": ["userId"]
    }
  }
}
